# ACA — modèle de configuration (§16.2 de docs/ACAM_roadmap.md)
#
#   cp .env.example .env      puis remplir ce dont vous avez besoin.
#
# Principe directeur du projet : **une variable absente = fonctionnalité ignorée, jamais un
# plantage** (dégradation gracieuse). Seul le bloc « strict minimum » ci-dessous est requis pour
# faire tourner une analyse. Tout le reste ajoute une capacité.
#
# ⚠️ EXCEPTION : avec `ACA_ENV=production`, les protections deviennent OBLIGATOIRES et l'application
# REFUSE de démarrer si elles manquent (aca/core/prod_check.py). En développement — le défaut —
# aucun contrôle n'est imposé.
#
# Ne mettez jamais de vraie valeur dans CE fichier : il est versionné. Le vrai fichier `.env` est
# gitignoré et exclu du contexte de build Docker.


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 1. STRICT MINIMUM — sans ça, aucune analyse ne tourne
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Groq (gratuit) — classification, extraction, supervision, rédaction. https://console.groq.com
GROQ_API_KEY=

# Google Sheets = CRM + base de connaissances. Compte de service (JSON) partagé avec le classeur.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEETS_ID=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 2. CAPACITÉS OPTIONNELLES — absentes = la fonctionnalité est simplement sautée
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Gemini (gratuit) — embeddings du RAG sémantique. Absent ⇒ repli sur la recherche par mots-clés.
GOOGLE_API_KEY=

# Tavily (gratuit, 1000 req/mois) — enrichissement d'entreprise + veille web. Absent ⇒ ignorés.
TAVILY_API_KEY=

# Gmail (OAuth « installed app »). 1er lancement = consentement navigateur, cf. README.
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# Supabase Postgres — checkpointer partagé entre processus + RAG pgvector.
# Absent ⇒ SqliteSaver local + cache d'embeddings en mémoire (identique fonctionnellement).
# ⚠️ Utiliser la chaîne « Session pooler » (IPv4) et un rôle applicatif restreint, pas `postgres`
#    (qui a BYPASSRLS et rendrait la RLS inopérante — cf. §14.3).
DATABASE_URL=

# HubSpot (jeton d'application privée) — écrit le lead en CRM réel, EN PLUS de Sheets.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE=default
HUBSPOT_DEALSTAGE=appointmentscheduled

# Lien de réservation ajouté aux propositions DEMANDE_DEMO. Absent ⇒ promesse vague, comme avant.
CALENDLY_URL=

# LangSmith (gratuit, 5k traces/mois) — tracing. Aucun code à changer, ces variables suffisent.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ACA


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 3. NOTIFICATIONS & ROUTAGE — prévenir un humain qu'une analyse attend
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Webhook entrant Slack (poster un message) — canal générique des leads.
SLACK_WEBHOOK_URL=
# Envoi d'une alerte à soi-même via le Gmail déjà authentifié (aucun nouveau service).
NOTIFY_EMAIL=

# Secret de signature de l'APP Slack — distinct du webhook ci-dessus. Active les boutons
# « ✅ Valider » / « ✕ Rejeter » DANS Slack (POST /slack/interactions).
# ⚠️ Absent ⇒ les boutons s'affichent mais un clic renvoie 503 : la boucle échoue FERMÉE.
SLACK_SIGNING_SECRET=

# Routage SUPPORT / AUTRE vers l'équipe compétente (chaque entrée indépendamment optionnelle).
SUPPORT_EMAIL=
SUPPORT_SLACK_WEBHOOK_URL=
HR_EMAIL=
HR_SLACK_WEBHOOK_URL=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 4. INTÉGRATION n8n / WEBHOOK SORTANT (§16.1.2) — palier « Enterprise »
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
# ⚠️ Entièrement facultatif : le palier « Solo » (poller + planificateur) est déjà automatisé 24/7
#    sans n8n. Voir n8n/README.md.

# URL du nœud Webhook n8n. Absente ⇒ aucun événement poussé (aucune erreur).
ACA_WEBHOOK_URL=
# Signe chaque envoi (X-ACA-Signature) pour que le destinataire vérifie l'origine. Recommandé.
ACA_WEBHOOK_SECRET=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 5. AUTOMATISATION DE FOND — c'est ce qui rend le système autonome
# ══════════════════════════════════════════════════════════════════════════════════════════════

# poller.py — intervalle d'interrogation de Gmail (secondes).
POLL_INTERVAL_SECONDS=60

# scheduler.py — cadence des travaux périodiques, en HEURES. `0` désactive un travail.
ACA_SCHEDULE_TICK_SECONDS=60
ACA_SCHEDULE_MAINTENANCE_HOURS=1
ACA_SCHEDULE_RELANCE_HOURS=24
ACA_SCHEDULE_RETENTION_HOURS=168
ACA_SCHEDULE_BILLING_HOURS=720

# Relances : jours d'inactivité avant relance, et nombre maximum de relances par lead.
RELANCE_DAYS=4
RELANCE_MAX_ROUNDS=3

# Rétention RGPD : âge au-delà duquel les données personnelles sont purgées.
RETENTION_DAYS=365


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 5bis. MODE DÉMONSTRATION (§16.3) — faire tourner ACA sans AUCUNE clé
# ══════════════════════════════════════════════════════════════════════════════════════════════

# `1` (ou true/yes/oui) remplace les trois modèles Groq par une doublure déterministe : le graphe
# reste le vrai (mêmes agents, même superviseur, même pause de validation), seuls les appels
# facturables sont simulés. Utile pour évaluer le projet sans créer cinq comptes externes.
#
# ⚠️ Contrairement à tout le reste de ce fichier, ce mode NE DÉGRADE PAS gracieusement : toute
# écriture réelle (Sheets, HubSpot, Gmail) échoue bruyamment au lieu d'être ignorée. C'est
# délibéré — écrire un faux lead dans le CRM d'un prospect pendant une démonstration serait un
# incident. Laissez vide en usage normal.
ACA_DEMO_MODE=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 6. SÉCURITÉ (§15) — optionnel en développement, OBLIGATOIRE en production
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Le commutateur central. `production` ⇒ prod_check.enforce() REFUSE de démarrer si une protection
# manque, coupe /docs, et impose les gardes ci-dessous.
ACA_ENV=development

# Clé partagée protégeant toutes les routes de l'API sauf /health, /metrics et /slack/interactions.
ACA_API_KEY=

# Limite de débit par client (clé d'API ou IP). `0` ou absent = désactivée.
ACA_RATE_LIMIT=0
ACA_RATE_WINDOW_SECONDS=60

# Garde dédiée de /metrics : Prometheus scrape sans jamais détenir la clé qui écrit dans le CRM.
ACA_METRICS_TOKEN=

# Réexpose /docs et /openapi.json même en production (mettre à 1). Coupés par défaut en prod.
ACA_ENABLE_DOCS=

# Gate Streamlit à mot de passe partagé — utilisé UNIQUEMENT si aucun compte nominatif n'existe.
# Créer un compte à la place : python -m aca.storage.user_store create <nom> --role admin
ACA_UI_PASSWORD=

# Expiration de session : TTL absolu (8 h) et délai d'inactivité (30 min). Le plus strict gagne ;
# l'activité repousse l'inactivité mais JAMAIS le TTL absolu.
ACA_SESSION_TTL_SECONDS=28800
ACA_SESSION_IDLE_SECONDS=1800

# Transforme la chaîne de hachage du journal d'audit en HMAC (falsification = clé requise).
# ⚠️ SEUL secret dont la rotation invalide la vérification des lignes existantes.
ACA_AUDIT_HMAC_KEY=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 7. MULTI-TENANT & COMMERCIALISATION
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Un déploiement = un tenant. Tague chaque ligne des registres locaux et de faq_embeddings.
ACA_ORG_ID=default

# Facturation à l'usage (Stripe). ⚠️ Jamais vérifiée contre un vrai compte Stripe.
# STRIPE_SUBSCRIPTION_ITEM_ID se règle PAR TENANT via le panneau « Réglages », pas ici.
STRIPE_API_KEY=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 8. CHEMINS DES BASES LOCALES — à ne changer que pour isoler plusieurs instances
# ══════════════════════════════════════════════════════════════════════════════════════════════

ACA_CHECKPOINT_DB=data/checkpoints.sqlite
ACA_QUEUE_DB=data/queue.sqlite
ACA_ANALYTICS_DB=data/analytics.sqlite
ACA_AUDIT_DB=data/audit.sqlite
ACA_FOLLOWUP_DB=data/followup.sqlite
ACA_CONFIG_DB=data/config.sqlite
ACA_USERS_DB=data/users.sqlite
ACA_SCHEDULE_DB=data/schedule.sqlite
