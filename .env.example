# ACA — modèle de configuration (§16.2 de docs/ACAM_roadmap.md)
#
#   cp .env.example .env      puis remplir ce dont vous avez besoin.
#
# Principe directeur du projet : **une variable absente = fonctionnalité ignorée, jamais un
# plantage** (dégradation gracieuse). Seul le bloc « strict minimum » ci-dessous est requis pour
# faire tourner une analyse. Tout le reste ajoute une capacité.
#
# ⚠️ EXCEPTION : avec `ACA_ENV=production`, les protections deviennent OBLIGATOIRES et l'application
# REFUSE de démarrer si elles manquent (aca/core/prod_check.py). En développement — le défaut —
# aucun contrôle n'est imposé.
#
# Ne mettez jamais de vraie valeur dans CE fichier : il est versionné. Le vrai fichier `.env` est
# gitignoré et exclu du contexte de build Docker.


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 1. STRICT MINIMUM — sans ça, aucune analyse ne tourne
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Groq (gratuit) — classification, extraction, supervision, rédaction. https://console.groq.com
GROQ_API_KEY=

# Google Sheets = CRM + base de connaissances. Compte de service (JSON) partagé avec le classeur.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEETS_ID=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 2. CAPACITÉS OPTIONNELLES — absentes = la fonctionnalité est simplement sautée
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Gemini (gratuit) — embeddings du RAG sémantique. Absent ⇒ repli sur la recherche par mots-clés.
GOOGLE_API_KEY=

# Tavily (gratuit, 1000 req/mois) — enrichissement d'entreprise + veille web. Absent ⇒ ignorés.
TAVILY_API_KEY=

# Gmail (OAuth « installed app »). 1er lancement = consentement navigateur, cf. README.
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# Supabase Postgres — checkpointer partagé entre processus + RAG pgvector.
# Absent ⇒ SqliteSaver local + cache d'embeddings en mémoire (identique fonctionnellement).
# ⚠️ Utiliser la chaîne « Session pooler » (IPv4) et un rôle applicatif restreint, pas `postgres`
#    (qui a BYPASSRLS et rendrait la RLS inopérante — cf. §14.3).
DATABASE_URL=

# HubSpot (jeton d'application privée) — écrit le lead en CRM réel, EN PLUS de Sheets.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE=default
HUBSPOT_DEALSTAGE=appointmentscheduled

# Lien de réservation ajouté aux propositions DEMANDE_DEMO. Absent ⇒ promesse vague, comme avant.
CALENDLY_URL=

# LangSmith (gratuit, 5k traces/mois) — tracing. Aucun code à changer, ces variables suffisent.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ACA


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 3. NOTIFICATIONS & ROUTAGE — prévenir un humain qu'une analyse attend
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Webhook entrant Slack (poster un message) — canal générique des leads.
SLACK_WEBHOOK_URL=
# Envoi d'une alerte à soi-même via le Gmail déjà authentifié (aucun nouveau service).
NOTIFY_EMAIL=

# Secret de signature de l'APP Slack — distinct du webhook ci-dessus. Active les boutons
# « ✅ Valider » / « ✕ Rejeter » DANS Slack (POST /slack/interactions).
# ⚠️ Absent ⇒ les boutons s'affichent mais un clic renvoie 503 : la boucle échoue FERMÉE.
SLACK_SIGNING_SECRET=

# Routage SUPPORT / AUTRE vers l'équipe compétente (chaque entrée indépendamment optionnelle).
SUPPORT_EMAIL=
SUPPORT_SLACK_WEBHOOK_URL=
HR_EMAIL=
HR_SLACK_WEBHOOK_URL=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 4. INTÉGRATION n8n / WEBHOOK SORTANT (§16.1.2) — palier « Enterprise »
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
# ⚠️ Entièrement facultatif : le palier « Solo » (poller + planificateur) est déjà automatisé 24/7
#    sans n8n. Voir n8n/README.md.

# URL du nœud Webhook n8n. Absente ⇒ aucun événement poussé (aucune erreur).
ACA_WEBHOOK_URL=
# Signe chaque envoi (X-ACA-Signature) pour que le destinataire vérifie l'origine. Recommandé.
ACA_WEBHOOK_SECRET=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 5. AUTOMATISATION DE FOND — c'est ce qui rend le système autonome
# ══════════════════════════════════════════════════════════════════════════════════════════════

# poller.py — intervalle d'interrogation de Gmail (secondes).
# ⚠️ Depuis §19, ce n'est plus que la valeur de REPLI : la cadence effective vient de
# INTAKE_INTERVAL_SECONDS ci-dessous, réglable depuis « Réglages → Réception automatique » sans
# redémarrer le processus. Conservée pour ne pas casser les déploiements existants.
POLL_INTERVAL_SECONDS=60

# §19 — FENÊTRE DE RÉCEPTION. Quand ACA relève la boîte de réception. Hors de cette plage, Gmail
# n'est pas contacté du tout : ni analyse à 3 h du matin, ni alerte le dimanche pour une équipe qui
# ne la lira que lundi. Rien n'est perdu — les e-mails non lus sont traités à la réouverture.
# Ces cinq valeurs sont aussi (et de préférence) réglables depuis l'interface, où elles sont
# stockées par tenant dans config.sqlite et l'emportent alors sur ce fichier.
INTAKE_ENABLED=1
# Jours : 0 = lundi … 6 = dimanche. Vide ou illisible = tous les jours (jamais « aucun jour », ce
# qui reviendrait à ne plus jamais relever la boîte).
INTAKE_DAYS=0,1,2,3,4,5,6
# Heures locales (HH:MM). Une plage à cheval sur minuit est acceptée : 22:00 → 06:00 fonctionne,
# le jour retenu étant celui où la fenêtre s'ouvre.
INTAKE_START=00:00
INTAKE_END=23:59
# Délai entre deux relevés, en secondes (borné entre 15 s et 6 h).
INTAKE_INTERVAL_SECONDS=60

# §19 — envois programmés et rappels posés par un humain sur un lead (storage/task_store.py).
ACA_TASK_DB=data/tasks.sqlite

# §20 — demandes de relecture : un opérateur transmet à un administrateur des e-mails qu'il ne veut
# pas trancher seul (storage/review_store.py). Distinct de ACA_TASK_DB : une tâche est DATÉE et
# s'exécute toute seule, une demande de relecture est ADRESSÉE et attend la décision de quelqu'un.
ACA_REVIEW_DB=data/reviews.sqlite

# scheduler.py — cadence des travaux périodiques, en HEURES. `0` désactive un travail.
ACA_SCHEDULE_TICK_SECONDS=60
ACA_SCHEDULE_MAINTENANCE_HOURS=1
ACA_SCHEDULE_RELANCE_HOURS=24
ACA_SCHEDULE_RETENTION_HOURS=168
ACA_SCHEDULE_BILLING_HOURS=720
# §18 — archive mensuelle signée du journal d'activité. La cadence ne fait que régler la fréquence
# de VÉRIFICATION (le mois archivé est toujours le dernier mois civil terminé, calculé
# automatiquement) ; archive_period() est idempotent, donc une vérification en trop n'écrit rien.
ACA_SCHEDULE_ARCHIVE_HOURS=720
ACA_ARCHIVE_DIR=data/archives
# §19 — exécution des envois programmés et des rappels. Seul travail à cadence SUB-HORAIRE, et
# c'est justifié : les autres traitent des échéances en jours ou en mois, celui-ci exécute une
# heure choisie par un humain. Une vérification horaire ferait partir à 15 h 00 un message demandé
# pour 14 h 15. 0.0167 h ≈ 1 min, soit un passage par tick ; ne coûte rien quand rien n'est dû.
ACA_SCHEDULE_TASKS_HOURS=0.0167
# §20 — rapport mensuel d'activité en PDF (core/reporting.py + integrations/report_pdf.py). Même
# convention que l'archive ci-dessus : cette cadence règle la fréquence de VÉRIFICATION, le mois
# couvert est toujours le dernier mois civil terminé, et l'écriture est idempotente (un rapport
# déjà présent n'est jamais réécrit). `0` désactive le rapport automatique ; la page « Rapports »
# de l'interface reste utilisable pour en produire à la demande.
ACA_SCHEDULE_REPORT_HOURS=720
ACA_REPORT_DIR=data/reports

# Relances : jours d'inactivité avant relance, et nombre maximum de relances par lead.
RELANCE_DAYS=4
RELANCE_MAX_ROUNDS=3

# Rétention RGPD : âge au-delà duquel les données personnelles sont purgées.
RETENTION_DAYS=365


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 5bis. MODE DÉMONSTRATION (§16.3) — faire tourner ACA sans AUCUNE clé
# ══════════════════════════════════════════════════════════════════════════════════════════════

# `1` (ou true/yes/oui) remplace les trois modèles Groq par une doublure déterministe : le graphe
# reste le vrai (mêmes agents, même superviseur, même pause de validation), seuls les appels
# facturables sont simulés. Utile pour évaluer le projet sans créer cinq comptes externes.
#
# ⚠️ Contrairement à tout le reste de ce fichier, ce mode NE DÉGRADE PAS gracieusement : toute
# écriture réelle (Sheets, HubSpot, Gmail) échoue bruyamment au lieu d'être ignorée. C'est
# délibéré — écrire un faux lead dans le CRM d'un prospect pendant une démonstration serait un
# incident. Laissez vide en usage normal.
ACA_DEMO_MODE=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 6. SÉCURITÉ (§15) — optionnel en développement, OBLIGATOIRE en production
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Le commutateur central. `production` ⇒ prod_check.enforce() REFUSE de démarrer si une protection
# manque, coupe /docs, et impose les gardes ci-dessous.
ACA_ENV=development

# Clé partagée protégeant toutes les routes de l'API sauf /health, /metrics et /slack/interactions.
ACA_API_KEY=

# Limite de débit par client (clé d'API ou IP). `0` ou absent = désactivée.
ACA_RATE_LIMIT=0
ACA_RATE_WINDOW_SECONDS=60

# Garde dédiée de /metrics : Prometheus scrape sans jamais détenir la clé qui écrit dans le CRM.
ACA_METRICS_TOKEN=

# Réexpose /docs et /openapi.json même en production (mettre à 1). Coupés par défaut en prod.
ACA_ENABLE_DOCS=

# Gate Streamlit à mot de passe partagé — utilisé UNIQUEMENT si aucun compte nominatif n'existe.
# Créer un compte à la place : python -m aca.storage.user_store create <nom> --role admin
ACA_UI_PASSWORD=

# Expiration de session : TTL absolu (8 h) et délai d'inactivité (30 min). Le plus strict gagne ;
# l'activité repousse l'inactivité mais JAMAIS le TTL absolu.
ACA_SESSION_TTL_SECONDS=28800
ACA_SESSION_IDLE_SECONDS=1800

# §24 — « Se souvenir de cet appareil » sur l'écran du second facteur : nombre de jours pendant
# lesquels un navigateur donné ne redemande pas le CODE. Le mot de passe, lui, reste exigé à chaque
# connexion : ce réglage espace le second facteur, il ne le supprime pas et n'allonge aucune session
# (voir ACA_SESSION_* ci-dessus, qui répondent à une tout autre question).
#
# `0` DÉSACTIVE la fonction et retire la case de l'écran — la seule façon, pour un déploiement
# strict, d'interdire ce compromis sans toucher au code (même convention que ACA_SCHEDULE_*_HOURS).
# Une valeur illisible retombe sur 3 : une variable mal saisie ne doit ni désactiver en silence une
# fonction attendue, ni empêcher quiconque de se connecter.
#
# Ce qui est réellement échangé, sans détour : sur ce navigateur et pour cette durée, on passe de
# « mot de passe + code » à « mot de passe + possession d'un jeton aléatoire déposé dans ce
# navigateur ». Changer de mot de passe (ou réinitialiser le TOTP) révoque TOUS les appareils
# mémorisés automatiquement, et chaque saut du second facteur est consigné au journal d'activité.
ACA_TOTP_TRUST_DAYS=3

# Transforme la chaîne de hachage du journal d'audit en HMAC (falsification = clé requise).
# ⚠️ SEUL secret dont la rotation invalide la vérification des lignes existantes.
ACA_AUDIT_HMAC_KEY=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 7. MULTI-TENANT & COMMERCIALISATION
# ══════════════════════════════════════════════════════════════════════════════════════════════

# Un déploiement = un tenant. Tague chaque ligne des registres locaux et de faq_embeddings.
ACA_ORG_ID=default

# Facturation à l'usage (Stripe). ⚠️ Jamais vérifiée contre un vrai compte Stripe.
# STRIPE_SUBSCRIPTION_ITEM_ID se règle PAR TENANT via le panneau « Réglages », pas ici.
STRIPE_API_KEY=

# ── §23.2 — Page de présentation : les URL commerciales ───────────────────────────────────────
# ⚠️ AUCUNE de ces lignes n'est lue par Python. Elles sont ici parce que c'est le fichier qu'on
# relit avant un déploiement ; leur vraie place est l'objet `CONFIG` en haut du <script> de
# `static/landing.html` — page statique servie telle quelle, rien ne peut y injecter une variable
# d'environnement. Aide-mémoire, donc, pas configuration.
#
# À NE PAS CONFONDRE avec STRIPE_API_KEY ci-dessus : celle-là compte les jetons consommés
# (`billing.py`) et n'encaisse rien ; les liens ci-dessous encaissent et ne comptent rien.
#
#   CONFIG.calendly  Lien de réservation. Renseigné ⇒ la carte affiche les DISPONIBILITÉS
#                    RÉELLES, journées complètes grisées par Calendly lui-même : la page n'a pas
#                    de backend, c'est la seule façon que cette promesse soit vraie. Vide ⇒ le
#                    sélecteur hors-ligne reste et dit qu'il ne réserve rien. Peut valoir la même
#                    chose que CALENDLY_URL (§3), qui sert à un autre usage — le lien collé dans
#                    les propositions DEMANDE_DEMO.
#   CONFIG.contact   Destinataire du formulaire de repli. Sans lui le `mailto:` s'ouvrait sans
#                    adresse : le seul chemin de conversion de la page n'arrivait nulle part.
#   CONFIG.demo      Instance de démonstration hébergée (ACA_DEMO_MODE=1). Vide ⇒ les deux boutons
#                    « démo » restent masqués plutôt que de pointer vers rien.
#   CONFIG.pay.*     Liens de paiement Stripe facultatifs, un par palier, TOUS vides à dessein.
#                    §25 : les trois paliers (Démonstration / Solo / Enterprise) décrivent les
#                    formes de déploiement réellement prises en charge par le code et ne vendent
#                    AUCUNE licence — la pile tient sur des paliers gratuits et les clés d'API sont
#                    celles du client. Ce qui se facture est l'installation et l'intégration, donc
#                    cela se devise après un appel plutôt que de se prendre depuis un bouton. Les
#                    trois montants d'exemple hérités d'un modèle de page ont été SUPPRIMÉS plutôt
#                    que devinés. N'en renseigner un que le jour où un forfait à prix fixe existe
#                    vraiment (une installation Solo au forfait, par exemple) : le bouton de ce
#                    palier mène alors directement au paiement, et pointer la redirection
#                    post-paiement de Stripe vers CONFIG.calendly enchaîne payer → réserver sans
#                    aucun serveur de notre côté.
# ACA_LANDING_CALENDLY=
# ACA_LANDING_CONTACT=
# ACA_DEMO_URL=
# STRIPE_PAYMENT_LINK_SOLO=
# STRIPE_PAYMENT_LINK_ENTERPRISE=


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 8. CHEMINS DES BASES LOCALES — à ne changer que pour isoler plusieurs instances
# ══════════════════════════════════════════════════════════════════════════════════════════════

ACA_CHECKPOINT_DB=data/checkpoints.sqlite
ACA_QUEUE_DB=data/queue.sqlite
ACA_ANALYTICS_DB=data/analytics.sqlite
ACA_AUDIT_DB=data/audit.sqlite
ACA_FOLLOWUP_DB=data/followup.sqlite
ACA_CONFIG_DB=data/config.sqlite
ACA_USERS_DB=data/users.sqlite
# §24 — navigateurs autorisés à sauter le second facteur (cf. ACA_TOTP_TRUST_DAYS).
ACA_DEVICE_TRUST_DB=data/device_trust.sqlite
ACA_SCHEDULE_DB=data/schedule.sqlite
ACA_ACTIVITY_DB=data/activity.sqlite


# ══════════════════════════════════════════════════════════════════════════════════════════════
# 9. IDENTITÉ VISUELLE (§17) — facultatif, tout se règle aussi depuis « Réglages → Apparence »
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
# Ces variables ne servent qu'à livrer une instance DÉJÀ aux couleurs du client (image Docker,
# déploiement automatisé) sans passer par l'interface. Un réglage fait dans l'UI est stocké par
# tenant et l'emporte sur la valeur ci-dessous ; laisser vide = palette ACA par défaut.
#
# Le logo, lui, ne se règle QUE depuis l'UI (téléversement d'un fichier, stocké encodé dans
# config.sqlite) : un chemin de fichier dans un `.env` casse dès que l'application change de
# machine ou tourne dans un conteneur au système de fichiers éphémère.

# BRAND_NAME=Assistant commercial agentique
# BRAND_TAGLINE=Pré-lecture et qualification des e-mails entrants — validation humaine avant écriture CRM.
# BRAND_COMPANY=                       # nom du client final, affiché en pied de page

# Préréglages disponibles : « ACA (défaut) », « Azur corporate », « Émeraude », « Ardoise & or »,
# « Corail », « Violet nuit (sombre) », « Carbone (sombre) ». Une couleur explicite ci-dessous
# l'emporte toujours sur le préréglage.
# BRAND_PRESET=ACA (défaut)

# BRAND_PRIMARY=#0078D4                # boutons, liens, éléments actifs
# BRAND_ACCENT=#8764B8                 # second ton des dégradés
# BRAND_BACKGROUND=#FFFFFF
# BRAND_SURFACE=#F5F7FA                # fond des cartes — doit se distinguer du fond principal
# BRAND_SIDEBAR=#F3F4F7
# BRAND_TEXT=#1A1A1A
# BRAND_BORDER=#E2E5EA
# BRAND_SUCCESS=#107C10
# BRAND_WARNING=#D83B01
# BRAND_DANGER=#E81123
# BRAND_INFO=#00B7C3

# Police : Inter | Open Sans | Roboto | Lato | Montserrat | Poppins | IBM Plex Sans |
#          Source Sans 3 | Nunito | Système   (« Système » n'appelle aucun CDN)
# BRAND_FONT=Inter
# BRAND_RADIUS=12px                    # 0px | 4px | 8px | 12px | 16px | 24px
# BRAND_DENSITY=confortable            # compacte | confortable | aérée
# BRAND_MODE=clair                     # clair | sombre
# BRAND_ANIMATIONS=complet             # complet | sobre | aucune — le réglage « réduire les
#                                      # animations » du système d'exploitation gagne dans tous les cas
# BRAND_HERO=dégradé animé             # dégradé animé | dégradé fixe | sobre | masqué

# Durée de conservation du journal d'activité (§17). Il contient des adresses IP, donc des données
# à caractère personnel : réglable séparément de RETENTION_DAYS, dont il reprend la valeur par
# défaut. Le journal d'audit des validations (audit.sqlite), lui, n'est jamais purgé.
# ACTIVITY_RETENTION_DAYS=365

# §18 — rétention à deux vitesses : les événements sensibles (échec de connexion, verrouillage,
# changement de rôle/réglages — activity_log.SENSITIVE_ACTIONS) sont conservés plus longtemps que
# le bruit d'usage courant, précisément parce qu'une enquête les cherche après coup. Défaut : deux
# fois ACTIVITY_RETENTION_DAYS.
# ACTIVITY_SENSITIVE_RETENTION_DAYS=730
