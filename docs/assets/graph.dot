digraph G {
rankdir=LR; bgcolor="transparent"; splines=true;
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.15,0.08"];
edge [color="#9e9e9e", fontname="Helvetica", fontsize=9, fontcolor="#757575"];
"START" [shape=ellipse, style=filled, fillcolor="#616161", fontcolor=white, label="START"];
"END" [shape=ellipse, style=filled, fillcolor="#616161", fontcolor=white, label="END"];
"ingestion" [label="Ingestion", fillcolor="#E0E0E0", fontcolor="black"];
"classifier" [label="Classifieur", fillcolor="#E0E0E0", fontcolor="black"];
"memory_lookup" [label="Mémoire", fillcolor="#E0E0E0", fontcolor="black"];
"risk_scan" [label="Risques", fillcolor="#E0E0E0", fontcolor="black"];
"extractor" [label="Extracteur", fillcolor="#E0E0E0", fontcolor="black"];
"clarification" [label="Clarification", fillcolor="#E0E0E0", fontcolor="black"];
"supervisor" [label="Superviseur", fillcolor="#E0E0E0", fontcolor="black"];
"enrichissement" [label="Enrichissement", fillcolor="#E0E0E0", fontcolor="black"];
"connaissance" [label="Connaissance", fillcolor="#E0E0E0", fontcolor="black"];
"veille" [label="Veille", fillcolor="#E0E0E0", fontcolor="black"];
"stratege" [label="Stratège", fillcolor="#E0E0E0", fontcolor="black"];
"reflection" [label="Réflexion", fillcolor="#E0E0E0", fontcolor="black"];
"routing" [label="Routage", fillcolor="#E0E0E0", fontcolor="black"];
"notification" [label="Notification", fillcolor="#E0E0E0", fontcolor="black"];
"action" [label="Action", fillcolor="#E0E0E0", fontcolor="black"];
"START" -> "ingestion";
"clarification" -> "supervisor";
"classifier" -> "memory_lookup";
"connaissance" -> "supervisor";
"enrichissement" -> "supervisor";
"extractor" -> "clarification";
"ingestion" -> "classifier";
"memory_lookup" -> "risk_scan";
"notification" -> "action";
"reflection" -> "routing" [label="ok"];
"reflection" -> "stratege" [style=dashed, label="rewrite"];
"risk_scan" -> "extractor";
"routing" -> "notification";
"stratege" -> "reflection";
"supervisor" -> "connaissance";
"supervisor" -> "enrichissement";
"supervisor" -> "routing" [label="FINISH"];
"supervisor" -> "stratege";
"supervisor" -> "veille";
"veille" -> "supervisor";
"action" -> "END";
}
