                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Settings Settings Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Settings"
      },
      "post": {
        "description": "Enregistre chaque réglage non vide — même contrat que le formulaire « Réglages » de `ui.py`.\n\n§15.1.4 : les clés inconnues sont refusées (422) au lieu d'être écrites. `config_store`\naccepte volontairement n'importe quelle clé texte (c'est un magasin générique), donc la liste\nblanche appartient à cette frontière-ci, la seule exposée au réseau.",
        "operationId": "update_settings_settings_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Update Settings Settings Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Settings"
      }
    },
    "/slack/interactions": {
      "post": {
        "description": "Reçoit les clics sur les boutons « Valider »/« Rejeter » d'une alerte Slack (cf.\n`notify.send_approval`) — la validation humaine se fait alors DANS Slack, sans ouvrir aucune UI.\n\nSécurité (cf. slack_verify.py) : cet endpoint n'est PAS derrière `require_api_key` (Slack\nn'envoie pas notre en-tête), il est protégé par la signature HMAC de Slack. Il échoue FERMÉ si\n`SLACK_SIGNING_SECRET` est absent — sans quoi n'importe qui pourrait forger une validation et\ndéclencher une écriture CRM.\n\nSlack attend une réponse < 3 s ; `action_node` (Sheets + HubSpot) tient généralement dans ce\nbudget au volume prototype. Une version production « à charge » accuserait réception\nimmédiatement puis mettrait à jour le message via `response_url` en tâche de fond — noté comme\nlimite connue, non nécessaire ici.",
        "operationId": "slack_interactions_slack_interactions_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Slack Interactions Slack Interactions Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Slack Interactions"
      }
    },
