    "/threads/{thread_id}/valider": {
      "post": {
        "description": "Résout la pause de validation humaine (`interrupt_before=[\"action\"]`) — SEUL point d'entrée de\ncette API qui déclenche l'écriture CRM (`action_node`). Édite le brouillon avant reprise si\n`edited_draft` est fourni, même logique que le bouton « Valider » de `ui.py`.",
        "operationId": "validate_thread_threads__thread_id__valider_post",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "title": "Thread Id",
