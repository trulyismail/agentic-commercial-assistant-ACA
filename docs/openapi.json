                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Stats Stats Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Stats"
      }
    },
    "/threads": {
      "post": {
        "description": "Démarre une nouvelle analyse — équivalent HTTP du formulaire manuel/import Gmail de `ui.py`.\n\n§16.1.1 : les pièces jointes (PDF/Word/Excel, transmises en base64) sont désormais acceptées et\ntransmises brutes au graphe, où `ingestion_node` en extrait le texte. Auparavant ce champ était\ncodé en dur à `[]`, ce qui privait tout client de l'API — donc n8n — de l'analyse multimodale,\npourtant le pilier d'innovation n°1 du projet.\n\n§16.1.4 — **idempotence** : si un `thread_id` fourni possède déjà un état, l'analyse n'est PAS\nrejouée et l'instantané existant est renvoyé avec `already_exists: true`. Le nœud HTTP de n8n\nréessaie par défaut en cas d'échec réseau ; sans cette garde, un simple réessai relançait une\nanalyse complète (deux appels 70B, du quota Tavily/Gemini) **et renotifiait** l'équipe pour le\nmême e-mail. C'est le pendant, côté API, de l'idempotence que `poller.py` obtient déjà en\nmarquant « en_cours » avant `invoke()`.\n\n§16.1.4 — **mode asynchrone** (`?mode=async`) : renvoie `202` immédiatement et exécute le\ngraphe en tâche de fond ; la fin est signalée par le webhook `analysis.paused` (§16.1.2). Le\nmode synchrone reste le défaut (aucun client existant n'est affecté), mais il retient la requête\n30 à 90 s — deux appels 70B, Tavily, embeddings, réflexion — ce qui devient fragile dès que les\nréessais de n8n se combinent au backoff 429 du palier gratuit de Groq.",
        "operationId": "create_thread_threads_post",
        "parameters": [
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "default": "sync",
              "title": "Mode",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create Thread Threads Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Thread"
      }
    },
