# Copier en .env.local (gitignoré) et remplir avant `npm run dev`.

# Doit être IDENTIQUE au ACA_API_KEY du backend Python (.env à la racine du projet). Si le backend
# tourne sans ACA_API_KEY réglée (mode développement), laisser vide ici aussi.
ACA_API_KEY=

# URL du microservice FastAPI (aca/api.py) : uvicorn aca.api:api --port 8000
ACA_API_URL=http://localhost:8000

# Mot de passe partagé du dashboard (même contrat que ACA_UI_PASSWORD côté Streamlit) — choisissez
# une valeur, ne réutilisez pas un mot de passe existant.
DASHBOARD_PASSWORD=

# Chaîne aléatoire longue, utilisée pour signer le cookie de session (HMAC) — générer par ex. avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SESSION_SECRET=
